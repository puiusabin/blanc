// Prisma Schema for Blanc Email Service
// Includes: User accounts, Email storage, Aliases, PGP Keys
// Database: Prisma Postgres (managed PostgreSQL)

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanType {
  FREE
  PREMIUM
}

enum EmailStatus {
  STORED
  DELETED
  QUARANTINED
}

enum EmailFolder {
  INBOX
  SENT
  DRAFTS
  SPAM
  TRASH
  ARCHIVE
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  planType      PlanType  @default(FREE)
  quotaBytes    BigInt    // 2GB for FREE, 20GB for PREMIUM
  usedBytes     BigInt    @default(0)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  emails        Email[]
  threads       Thread[]
  aliases       Alias[]   @relation("AliasTarget")
  pgpKeys       PGPKey[]

  @@index([email])
  @@index([active])
}

model Thread {
  id              String       @id @default(uuid())
  userId          String

  // Thread metadata
  subject         String       @db.VarChar(998)
  rootMessageId   String?      // First Message-ID in thread

  // Denormalized counts
  messageCount    Int          @default(1)
  unreadCount     Int          @default(1)

  // Thread-level state
  folder          EmailFolder  @default(INBOX)
  hasAttachments  Boolean      @default(false)
  isStarred       Boolean      @default(false)

  // Participants JSONB: [{ email: string, name: string | null }]
  participants    Json         @default("[]")

  // Timestamps
  lastMessageAt   DateTime     @default(now())
  firstMessageAt  DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails          Email[]

  // Indexes
  @@index([userId, folder, lastMessageAt(sort: Desc)])
  @@index([rootMessageId])
}

model Email {
  id            String       @id @default(uuid())
  messageId     String?      // RFC Message-ID header for deduplication
  userId        String
  threadId      String?      // Thread relationship (nullable for migration)

  // Timestamps
  dateReceived  DateTime     @default(now())
  dateSent      DateTime?    // Date header from email

  // Storage
  sizeBytes     BigInt
  r2DatagramPath String      // Path to .json.gz: {userId}/{year}/{month}/{emailId}.json.gz

  // Content flags (for filtering without R2 fetch)
  hasHtml       Boolean      @default(false)
  hasPlainText  Boolean      @default(false)
  hasAttachments Boolean     @default(false)
  attachmentCount Int        @default(0)

  // State flags
  encrypted     Boolean      @default(false)
  isRead        Boolean      @default(false)
  isStarred     Boolean      @default(false)
  folder        EmailFolder  @default(INBOX)
  status        EmailStatus  @default(STORED)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread        Thread?      @relation(fields: [threadId], references: [id], onDelete: SetNull)
  attachments   Attachment[]

  // Indexes
  @@index([userId, dateReceived(sort: Desc)])
  @@index([userId, folder, isRead])
  @@index([userId, folder, dateReceived(sort: Desc)])
  @@index([messageId])
  @@index([threadId, dateReceived(sort: Desc)])
}

model Alias {
  id            String    @id @default(uuid())
  aliasAddress  String    @unique  // The alias email address
  targetUserId  String                // User who receives the mail
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  targetUser    User      @relation("AliasTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([aliasAddress])
  @@index([targetUserId])
}

model PGPKey {
  id            String    @id @default(uuid())
  userId        String
  publicKey     String    @db.Text  // Armored public key
  privateKey    String?   @db.Text  // Armored private key (optional, for web client decryption)
  fingerprint   String
  algorithm     String    // e.g., "rsa4096", "ed25519"
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  expiresAt     DateTime?

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
  @@index([fingerprint])
}

model Attachment {
  id            String    @id @default(uuid())
  emailId       String
  userId        String    // Denormalized for quota tracking

  // File metadata
  filename      String    @db.VarChar(255)
  mimeType      String    @db.VarChar(100)
  sizeBytes     BigInt
  contentId     String?   // For inline images (cid:)

  // R2 storage
  r2Path        String    // {userId}/{year}/{month}/{emailId}/attachments/{attachmentId}_{filename}

  // Content disposition
  isInline      Boolean   @default(false)

  createdAt     DateTime  @default(now())

  // Relations
  email         Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([emailId])
  @@index([userId])
  @@index([contentId])
}
