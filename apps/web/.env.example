# Next.js Environment
NEXTJS_ENV=development

# WalletConnect Project ID (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WC_PROJECT_ID=your_project_id_here

# Stalwart Mail Server Configuration
STALWART_DOMAIN=mail.example.com
STALWART_JMAP_URL=https://mail.example.com/.well-known/jmap
STALWART_SMTP_HOST=mail.example.com
STALWART_SMTP_PORT=587
STALWART_IMAP_HOST=mail.example.com
STALWART_IMAP_PORT=993