# Next.js Environment
NEXTJS_ENV=development

# WalletConnect Project ID (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WC_PROJECT_ID=your_project_id_here

# Session Secret (minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_64_character_session_secret_here_change_this_in_production

# Cloudflare R2 Storage (for email attachments and datagrams)
# Get credentials from: https://dash.cloudflare.com → R2 → Manage R2 API Tokens
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=mail-storage
R2_ACCOUNT_ID=your_cloudflare_account_id

# Email Service (Haraka SMTP server in services/haraka)
# See services/haraka/.env.example for Haraka configuration