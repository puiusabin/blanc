# Database
# Add your database connection string
# For local development with PostgreSQL:
DATABASE_URL="postgresql://user:password@localhost:5432/blanc"

# Or use Prisma Postgres (https://console.prisma.io)
# DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_API_KEY"

# Cloudflare R2 Storage (shared between web app and Haraka)
# Get credentials from: https://dash.cloudflare.com → R2 → Manage R2 API Tokens
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=mail-storage
R2_ACCOUNT_ID=your_cloudflare_account_id
