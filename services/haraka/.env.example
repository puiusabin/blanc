# Blanc Mail Server - Environment Variables
# Copy this file to .env and fill in your actual credentials

# ============================================================
# DATABASE
# ============================================================
# Prisma Postgres (Accelerate) connection string
# Get this from: https://console.prisma.io/
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_API_KEY_HERE"

# ============================================================
# CLOUDFLARE R2 STORAGE
# ============================================================
# R2 Access Credentials
# Create at: Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCESS_KEY_ID="your_r2_access_key_id_here"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key_here"

# R2 Endpoint
# Format: https://{ACCOUNT_ID}.r2.cloudflarestorage.com
# Your account ID is visible in the R2 dashboard
R2_ENDPOINT="https://YOUR_ACCOUNT_ID.eu.r2.cloudflarestorage.com"

# R2 Bucket Name
# The bucket you created for email storage
R2_BUCKET="mail-storage"

# ============================================================
# EMAIL SERVICE CONFIGURATION
# ============================================================
# Enable PGP encryption (default: false for development)
ENCRYPTION_ENABLED=false

# Require PGP keys for all users (default: false)
REQUIRE_PGP_KEYS=false

# Node environment
NODE_ENV=development

# ============================================================
# OPTIONAL OVERRIDES
# ============================================================
# These override config/cf_r2_queue.json if set

# Compress emails before upload (default: true)
# R2_ZIP_BEFORE_UPLOAD=true

# File extension for stored emails (default: .eml.gz)
# R2_FILE_EXTENSION=.eml.gz

# Copy email to all recipients or just first (default: true)
# R2_COPY_ALL_ADDRESSES=true
