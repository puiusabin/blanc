{
  "name": "blanc",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "description": "Blanc - Web3 mail application monorepo",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@blanc/web",
    "dev:mail": "turbo run dev --filter=@blanc/mail-server",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@blanc/web",
    "lint": "turbo run lint",
    "lint:fix": "npm run lint --workspace=@blanc/web -- --fix",
    "type-check": "turbo run type-check",
    "deploy": "turbo run deploy --filter=@blanc/web",
    "preview": "turbo run preview --filter=@blanc/web",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:push": "turbo run db:push",
    "db:studio": "turbo run db:studio",
    "db:seed": "turbo run db:seed",
    "clean": "turbo run clean && rm -rf node_modules",
    "clean:deep": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' + && find . -name '.next' -type d -prune -exec rm -rf '{}' + && find . -name 'dist' -type d -prune -exec rm -rf '{}' +",
    "install:all": "npm install",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "check": "turbo run type-check lint"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "keywords": [
    "blanc",
    "mail",
    "web3",
    "nextjs",
    "prisma",
    "monorepo"
  ],
  "author": "",
  "license": "GPL-3.0",
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.5.8"
  }
}
