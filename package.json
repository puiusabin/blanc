{
  "name": "blanc",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for blanc",
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:haraka": "npm run dev --workspace=services/haraka",
    "build": "npm run build --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "deploy:web": "npm run deploy --workspace=apps/web",
    "docker:up": "cd docker && docker-compose up -d",
    "docker:down": "cd docker && docker-compose down",
    "docker:logs": "cd docker && docker-compose logs -f",
    "docker:prod": "cd docker && docker-compose -f docker-compose.prod.yml up -d",
    "setup": "./scripts/setup-local.sh",
    "clean": "rm -rf apps/web/.next apps/web/node_modules services/haraka/node_modules node_modules"
  },
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "keywords": [
    "mail",
    "haraka",
    "nextjs",
    "web3",
    "monorepo"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {}
}