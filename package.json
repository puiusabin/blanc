{
  "name": "blanc",
  "version": "1.0.0",
  "private": true,
  "description": "Blanc - Web3 mail application monorepo",
  "scripts": {
    "dev": "npm run db:generate && npm run dev:web",
    "dev:web": "npm run dev --workspace=@blanc/web",
    "dev:mail": "npm run dev --workspace=@blanc/mail-server",
    "build": "npm run db:generate && npm run build:web",
    "build:web": "npm run build --workspace=@blanc/web",
    "lint": "npm run lint --workspace=@blanc/web",
    "lint:fix": "npm run lint --workspace=@blanc/web -- --fix",
    "type-check": "npm run type-check --workspace=@blanc/web",
    "deploy": "npm run deploy --workspace=@blanc/web",
    "preview": "npm run preview --workspace=@blanc/web",
    "db:generate": "npm run db:generate --workspace=@blanc/database",
    "db:migrate": "npm run db:migrate --workspace=@blanc/database",
    "db:push": "npm run db:push --workspace=@blanc/database",
    "db:studio": "npm run db:studio --workspace=@blanc/database",
    "db:seed": "npm run db:seed --workspace=@blanc/database",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "clean:deep": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' + && find . -name '.next' -type d -prune -exec rm -rf '{}' + && find . -name 'dist' -type d -prune -exec rm -rf '{}' +",
    "install:all": "npm install",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "check": "npm run type-check && npm run lint"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "keywords": [
    "blanc",
    "mail",
    "web3",
    "nextjs",
    "prisma",
    "monorepo"
  ],
  "author": "",
  "license": "GPL-3.0",
  "devDependencies": {
    "prettier": "^3.4.2"
  }
}